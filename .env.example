# Environment configuration for Starlly (backend only)
# Copy to `.env` and fill what you need. Never commit `.env`.
# The app also works with zero keys: sample data loads first; provider settings can be entered in Settings UI.

# ── Server ────────────────────────────────────────────────
PORT=8787
# Directory for the SQLite database and backups (created if missing)
DATA_DIR=./data
# Public HTTPS base URL used to build customer-page links.
# Must be reachable by customers (deploy or tunnel). Localhost is preview-only.
PUBLIC_BASE_URL=https://your-domain.example

# ── Email provider: agentboxd (default adapter) ───────────
AGENTBOXD_API_KEY=
AGENTBOXD_INBOX_ID=
AGENTBOXD_BASE_URL=https://api.agentboxd.com

# ── Email provider: openmail.sh (optional) ────────────────
OPENMAIL_API_KEY=
OPENMAIL_BASE_URL=https://openmail.sh

# ── AI provider (drafting, summaries, chat) ───────────────
# Style: anthropic (Messages) or openai (Chat Completions)
AI_PROVIDER_STYLE=openai
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=

# ── Optional services ─────────────────────────────────────
# Google Places API (New): business rating + review count only
GOOGLE_PLACES_API_KEY=
# Exa web search (optional business-profile enrichment; free plan is rate-limited)
EXA_API_KEY=